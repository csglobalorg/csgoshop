/* Reset & Base */
::-webkit-scrollbar {
    width: 10px;
}

::-webkit-scrollbar-track {
    background: var(--secondary-color);
}

::-webkit-scrollbar-thumb {
    background: var(--border-color);
    border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--text-light);
}

/* Loader */
.loader-container { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: var(--secondary-color); z-index: 9999; display: flex; justify-content: center; align-items: center; transition: opacity 0.5s; }
.spinner { width: 50px; height: 50px; border: 5px solid var(--border-color); border-top: 5px solid var(--accent-color); border-radius: 50%; animation: spin 1s linear infinite; }
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

:root {
    --primary-color: #0f172a;
    --secondary-color: #020617; /* Deep midnight black */
    --accent-color: #f59e0b;
    --accent-hover: #fbbf24;
    --accent-gradient: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    --bg-success: rgba(34, 197, 94, 0.1);
    --text-success: #22c55e;
    --bg-danger: rgba(239, 68, 68, 0.1);
    --text-danger: #ef4444;
    --text-color: #f8fafc;
    --text-light: #94a3b8;
    --bg-light: #1e293b;
    --bg-card: #0b1220; /* Requested card color */
    --bg-glass: rgba(11, 18, 32, 0.85);
    --bg-glass-heavy: rgba(11, 18, 32, 0.95);
    --border-color: rgba(255, 255, 255, 0.08);
    --border-focus: rgba(245, 158, 11, 0.4);
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    --shadow-premium: 0 20px 40px -10px rgba(0, 0, 0, 0.5);
    --transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    
    /* Responsive font sizes */
    --fs-h1: clamp(2.25rem, 6vw, 3.5rem);
    --fs-h2: clamp(1.75rem, 5vw, 2.5rem);
    --fs-h3: clamp(1.25rem, 3vw, 1.5rem);
    --fs-p: clamp(0.95rem, 2vw, 1.1rem);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    overflow-x: hidden;
    width: 100%;
}

body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: var(--text-color);
    background-color: var(--secondary-color);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    background-image: 
        radial-gradient(at 0% 0%, rgba(245, 158, 11, 0.03) 0, transparent 50%), 
        radial-gradient(at 50% 0%, rgba(15, 23, 42, 0.3) 0, transparent 50%);
    background-attachment: fixed;
}

.reveal {
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

a {
    text-decoration: none;
    color: inherit;
}

ul {
    list-style: none;
}

.container {
    max-width: 1536px;
    margin: 0 auto;
    padding: 0 20px;
    padding-top: 0 !important;
}

img {
    max-width: 100%;
    height: auto;
}

/* Header */
.header {
    background-color: var(--bg-glass);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    color: white;
    box-shadow: var(--shadow-md);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 1000;
    transition: var(--transition);
}

.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 80px;
}

.logo {
    display: flex;
    align-items: center;
    height: 100%;
}

.logo img {
    height: 60px;
    cursor: pointer;
    object-fit: contain;
    transition: transform 0.3s ease;
}

.logo img:hover {
    transform: scale(1.05);
}

.nav-menu > ul {
    display: flex;
    gap: 35px;
    align-items: center;
    height: 100%;
}

.nav-menu a {
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    transition: var(--transition);
    position: relative;
    padding: 5px 0;
    color: var(--text-color);
}

.nav-menu > ul > li > a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--accent-color);
    transition: width 0.3s ease;
    border-radius: 2px;
}

.nav-menu > ul > li > a:hover::after {
    width: 100%;
}

.nav-menu a:hover {
    color: var(--accent-color);
}

.dropdown {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
}

.dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: rgba(26, 30, 36, 0.98);
    backdrop-filter: blur(4px);
    box-shadow: 0 10px 40px rgba(0,0,0,0.6);
    min-width: 240px;
    display: none;
    flex-direction: column;
    gap: 0;
    padding: 12px 0;
    border-radius: 12px;
    z-index: 1000;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transform: translateY(10px);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: 80vh; /* Scrollable if too long */
    overflow-y: auto;
}

.dropdown:hover .dropdown-menu {
    display: flex;
    transform: translateY(0);
    opacity: 1;
}

.dropdown-menu li a {
    padding: 12px 24px;
    display: block;
    transition: all 0.2s ease;
    font-size: 0.9rem;
    color: var(--text-light);
}

.dropdown-menu li a:hover {
    background-color: rgba(249, 158, 26, 0.08);
    color: var(--accent-color);
    padding-left: 30px;
}

.nested-dropdown {
    position: relative;
}

.nested-dropdown-menu {
    position: absolute;
    top: -12px;
    left: 100%;
    background: rgba(26, 30, 36, 0.98);
    backdrop-filter: blur(4px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    min-width: 200px;
    display: none;
    flex-direction: column;
    padding: 10px 0;
    border-radius: 8px;
    z-index: 1000;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transform: translateX(10px);
    opacity: 0;
    transition: all 0.3s ease;
    max-height: 70vh; /* Scrollable if too long */
    overflow-y: auto;
}

.nested-dropdown:hover .nested-dropdown-menu {
    display: flex;
    transform: translateX(0);
    opacity: 1;
}

.header-actions-wrapper {
    display: flex;
    align-items: center;
    gap: 20px;
}

.search-bar {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 30px;
    padding: 6px 18px;
    transition: all 0.3s ease;
}

.search-bar:focus-within {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--accent-color);
    box-shadow: 0 0 0 3px rgba(249, 158, 26, 0.15);
}

.search-bar input {
    border: none;
    outline: none;
    padding: 8px 10px;
    width: 220px;
    color: var(--text-color);
    background: transparent;
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    font-size: 0.9rem;
}

.search-bar input::placeholder {
    color: rgba(255, 255, 255, 0.5);
}

.search-bar input:focus {
    width: 280px;
}

.search-bar button {
    background: none;
    border: none;
    color: var(--text-light);
    cursor: pointer;
    padding: 5px;
    transition: color 0.3s ease;
    font-size: 1.1rem;
}

.search-bar button:hover {
    color: var(--accent-color);
}

/* Universal Mobile Search Bar (Clean & Premium) */
.mobile-search-bar {
    display: none;
    background: rgba(3, 7, 18, 0.9);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 18px 0;
    width: 100%;
    position: fixed;
    top: 80px; 
    left: 0;
    z-index: 1100;
    box-shadow: 0 15px 40px rgba(0,0,0,0.6);
    transform: translateY(-5px);
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.mobile-search-bar.active {
    display: block;
    transform: translateY(0);
    opacity: 1;
}

.mobile-search-bar .container {
    padding: 0 15px;
}

.mobile-search-bar .search-bar {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: 100px;
    padding: 5px 6px 5px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.3s ease;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
}

.mobile-search-bar .search-bar:focus-within {
    border-color: var(--accent-color);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 0 15px rgba(245, 158, 11, 0.1);
}

.mobile-search-bar input {
    background: transparent !important;
    border: none !important;
    outline: none !important;
    color: white !important;
    padding: 10px 0 !important;
    width: 100%;
    font-size: 0.95rem;
    font-weight: 400;
}

.mobile-search-bar input::placeholder {
    color: rgba(255, 255, 255, 0.4);
}

.mobile-search-bar button {
    background: var(--accent-color);
    color: #030712;
    border: none;
    width: 34px;
    height: 34px;
    min-width: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    margin-left: 10px;
}

.mobile-search-bar button svg {
    width: 16px;
    height: 16px;
    stroke-width: 2.5;
}

.mobile-search-bar button:hover {
    transform: scale(1.08);
    background: var(--accent-hover);
}

@keyframes fadeInOverlay {
    from { opacity: 0; }
    to { opacity: 1; }
}

.header-icons {
    display: flex;
    align-items: center;
    gap: 15px;
}

.header-icons > div {
    width: 42px;
    height: 42px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
    cursor: pointer;
    position: relative;
    font-size: 1.1rem;
}

.header-icons > div:hover {
    background: rgba(249, 158, 26, 0.1);
    border-color: rgba(249, 158, 26, 0.2);
    color: var(--accent-color);
    transform: translateY(-2px);
}

.cart-icon {
    font-size: 1.1rem;
}

.cart-count {
    position: absolute;
    top: -5px;
    right: -5px;
    background-color: #e2136e;
    color: white;
    font-size: 0.7rem;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
    box-shadow: 0 2px 5px rgba(0,0,0,0.5);
    border: 2px solid var(--primary-color);
}

.mobile-menu-toggle {
    display: none;
    font-size: 1.2rem;
}

.mobile-search-toggle {
    display: none;
    font-size: 1.1rem;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    color: var(--text-color);
    cursor: pointer;
    transition: var(--transition);
}

.mobile-search-bar {
    display: none;
}

.mobile-search-toggle:hover {
    background: rgba(245, 158, 11, 0.1);
    color: var(--accent-color);
}

/* Hero Banner */
.hero {
    padding: 100px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, transparent 0%, var(--secondary-color) 100%);
    pointer-events: none;
}

@keyframes rotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.hero .container {
    position: relative;
    z-index: 2;
}

.hero h1 {
    font-size: var(--fs-h1);
    margin-bottom: 20px;
    font-weight: 800;
    letter-spacing: -1px;
    color: #ffffff;
    text-shadow: 0 10px 30px rgba(0,0,0,0.5);
    line-height: 1.1;
}

.hero p {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 40px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent-color) 0%, var(--accent-hover) 100%);
    color: #020617;
    padding: 12px 28px;
    min-height: 44px; /* Ensure better touch targets for mobile */
    border-radius: 12px;
    font-weight: 700;
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: pointer;
    transition: var(--transition);
    box-shadow: 0 4px 14px 0 rgba(245, 158, 11, 0.25);
    font-size: 0.95rem;
    letter-spacing: 0.3px;
    position: relative;
    overflow: hidden;
}

.btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(245, 158, 11, 0.4);
}

.btn:active {
    transform: translateY(0) scale(0.96);
}

.btn::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: rgba(255,255,255,0.2);
    transform: rotate(45deg) translateY(-100%);
    transition: var(--transition);
    pointer-events: none;
}

.btn:hover::after {
    transform: rotate(45deg) translateY(100%);
}

.btn:hover {
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.5);
    transform: translateY(-2px);
}

.btn-outline {
    background: transparent;
    border: 1.5px solid var(--accent-color);
    color: var(--accent-color);
    box-shadow: none;
    min-height: 44px;
}

.btn-outline::after {
    display: none;
}

.btn-outline:hover {
    background: var(--accent-color);
    color: #020617;
    box-shadow: 0 4px 14px 0 rgba(245, 158, 11, 0.39);
}

.btn-whatsapp {
    background-color: #25D366;
    color: white;
    border-color: #25D366;
    box-shadow: 0 0 10px rgba(37, 211, 102, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.btn-whatsapp:hover {
    background-color: #1ebe57;
    border-color: #1ebe57;
    box-shadow: 0 0 15px rgba(37, 211, 102, 0.6);
    transform: translateY(-2px);
}

/* Product Detail Actions */
.product-detail-actions {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
}

.btn-action-sm {
    padding: 8px 16px;
    font-size: 0.85rem;
    min-height: 38px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-color);
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: var(--transition);
}

.btn-action-sm:hover {
    background: rgba(245, 158, 11, 0.1);
    border-color: var(--accent-color);
    color: var(--accent-color);
    transform: translateY(-1px);
}

.btn-action-sm i {
    font-size: 0.9rem;
}

/* Floating WhatsApp */
.whatsapp-float {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background-color: #25D366;
    color: white;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 35px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    z-index: 1000;
    transition: all 0.3s ease;
    animation: pulse-wa 2s infinite;
}

.whatsapp-float:hover {
    transform: scale(1.1);
    color: white;
}

@keyframes pulse-wa {
    0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7); }
    70% { box-shadow: 0 0 0 15px rgba(37, 211, 102, 0); }
    100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
}

/* Sections */
.section-title {
    text-align: center;
    margin: 50px 0 30px;
    font-size: 2rem;
    color: var(--text-color);
}

/* Hero Banner - FINAL FIX with IMG */
.hero {
    position: relative;
    min-height: 560px !important;
    display: flex;
    align-items: center;
    overflow: hidden;
}

/* actual background image */
.hero-img {
    position: absolute;
    right: 0;
    top: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    z-index: 0;
}

/* dark overlay */
.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        90deg,
        rgba(2, 6, 23, 0.85) 0%,
        rgba(2, 6, 23, 0.55) 45%,
        rgba(2, 6, 23, 0.2) 70%,
        transparent 100%
    );
    z-index: 1;
}

/* content stays above */
.hero-content {
    position: relative;
    z-index: 2;
    max-width: 650px;
}



@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
}

.hero-content {
    max-width: 600px;
    z-index: 2;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(245, 158, 11, 0.1);
    color: var(--accent-color);
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 25px;
    border: 1px solid rgba(245, 158, 11, 0.2);
}

.hero h1 {
    font-size: 3.5rem;
    line-height: 1.1;
    margin-bottom: 12px;
    font-weight: 800;
    background: linear-gradient(to right, #fff 70%, var(--accent-color));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-subtitle {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 1rem;
    color: white;
    margin-bottom: 15px;
}

.hero p {
    font-size: 0.95rem;
    color: var(--text-light);
    margin-bottom: 25px;
    max-width: 480px;
    line-height: 1.6;
}

.hero-trust-indicators {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 30px;
}

.trust-indicator {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.02);
    padding: 12px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

@media (max-width: 992px) {
    .hero {
        min-height: auto;
        padding: 40px 0;
    }
    .hero-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }
    .hero-content {
        text-align: center;
        order: 2;
        max-width: 100%;
    }
    .hero-image-container {
        order: 1;
        margin-bottom: 0;
    }
    .hero-image-container img {
        max-height: 300px;
    }
    .hero h1 {
        font-size: 2.2rem;
        text-align: center;
    }
    .hero p {
        text-align: center;
        margin-left: auto;
        margin-right: auto;
    }
    .hero-subtitle {
        justify-content: center;
    }
    .hero-btns {
        justify-content: center;
    }
}

@media (max-width: 768px) {
    .hero {
        min-height: 420px;
        padding: 60px 20px 30px;
        text-align: center;
    }

    .hero::before {
        background: linear-gradient(
            180deg,
            rgba(2, 6, 23, 0.85) 0%,
            rgba(2, 6, 23, 0.55) 60%,
            rgba(2, 6, 23, 0.2) 100%
        );
    }

    .hero-content {
        margin: auto;
    }

    .hero-trust-indicators {
        grid-template-columns: 1fr;
    }
}

/* Trust Section */
.trust-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    margin-bottom: 80px;
}

.trust-card {
    background: var(--bg-glass);
    padding: 30px;
    border-radius: 20px;
    border: 1px solid var(--border-color);
    text-align: center;
    transition: var(--transition);
}

.trust-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-color);
    box-shadow: var(--shadow-premium);
}

.trust-icon {
    width: 70px;
    height: 70px;
    background: rgba(245, 158, 11, 0.08);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    color: #f59e0b; /* User requested color */
    transition: var(--transition);
}

.trust-icon i, .trust-icon svg {
    width: 42px; /* User requested size */
    height: 42px;
    stroke-width: 1.5px;
}

.trust-card h3 {
    font-size: 1.2rem;
    margin-bottom: 10px;
}

.trust-card p {
    font-size: 0.9rem;
    color: var(--text-light);
}

/* Category Grid Improvements */
.categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 20px;
    margin-bottom: 60px;
}

.category-card {
    background: rgba(30, 41, 59, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 25px 15px;
    text-align: center;
    border-radius: 16px;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 15px;
}

.category-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-color);
    background: rgba(30, 41, 59, 0.8);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4), 0 0 15px rgba(245, 158, 11, 0.2);
}

.category-card i, .category-card svg {
    font-size: 2.5rem;
    color: var(--accent-color);
    transition: all 0.3s;
}

.category-card:hover i, .category-card:hover svg {
    transform: scale(1.1);
}

.category-card h3 {
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.5px;
    margin: 0;
    color: var(--text-color);
}

/* Products */
.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px; /* Standardized gap as requested */
    margin-bottom: 60px; /* Increased margin for sections */
}

.product-card {
    background: var(--bg-glass);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.product-card:hover {
    transform: translateY(-8px);
    border-color: var(--accent-color);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(245, 158, 11, 0.15);
}

.product-card.out-of-stock {
    opacity: 0.8;
}

/* Wishlist Icon */
.wishlist-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
    width: 36px;
    height: 36px;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    transition: all 0.3s;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.wishlist-btn:hover {
    background: var(--accent-color);
    color: white;
    transform: scale(1.1);
}

.wishlist-btn.active {
    background: #ef4444;
    color: white;
    border-color: #ef4444;
}

.product-img {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1/1;
    background: var(--bg-light); /* Standard background color */
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
}

.product-img img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Changed to cover for better consistency, or keep contain with padding */
    padding: 10px; /* Consistent padding */
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.product-card:hover .product-img img {
    transform: scale(1.1);
}

/* Quick View Overlay */
.quick-view-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
}

.product-card:hover .quick-view-overlay {
    opacity: 1;
    pointer-events: auto;
}

.quick-view-btn {
    background: white;
    color: #1e293b;
    padding: 10px 18px;
    border-radius: 25px;
    font-size: 0.85rem;
    font-weight: 600;
    transform: translateY(20px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    gap: 8px;
    border: none;
}

.product-card:hover .quick-view-btn {
    transform: translateY(0);
}

.quick-view-btn:hover {
    background: var(--accent-color);
    color: white;
}

.product-info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.product-category {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--text-light);
    margin-bottom: 8px;
    letter-spacing: 1px;
    font-weight: 600;
}

.product-title {
    font-size: 1.05rem;
    margin-bottom: 12px;
    font-weight: 500;
    line-height: 1.4;
    height: 2.8em;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    color: var(--text-color);
    transition: color 0.3s;
}

.product-card:hover .product-title {
    color: var(--accent-color);
}

.product-price {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-color);
    margin-bottom: 15px;
    margin-top: auto;
}

.old-price {
    font-size: 0.9rem;
    color: var(--text-light);
    text-decoration: line-through;
    font-weight: 400;
}

.product-actions {
    display: flex;
    gap: 10px;
}

.product-actions button {
    flex: 1;
    padding: 12px 10px;
    font-size: 0.95rem;
    font-weight: 600;
    min-height: 44px;
}

.badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    pointer-events: none;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    animation: badge-in 0.4s ease-out;
}

@keyframes badge-in {
    from { transform: translateX(-10px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}

.badge.sale { background: linear-gradient(135deg, #ef4444, #b91c1c); color: white; }
.badge.new { background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; }
.badge.hot { background: linear-gradient(135deg, #f97316, #c2410c); color: white; }

.badge.trending { 
    background: linear-gradient(135deg, #8b5cf6, #6d28d9); 
    color: white;
    box-shadow: 0 0 15px rgba(139, 92, 246, 0.4);
}

.badge.best-seller { 
    background: linear-gradient(135deg, #10b981, #047857); 
    color: white;
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
}

.badge.limited { 
    background: linear-gradient(135deg, #f59e0b, #b45309); 
    color: white;
    box-shadow: 0 0 15px rgba(245, 158, 11, 0.3);
}

.badge.stock-out { background: #64748b; color: white; }

.product-card {
    animation: fade-up 0.5s ease-out;
}

@keyframes fade-up {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}

.urgency-label {
    font-size: 0.75rem;
    color: #ef4444;
    font-weight: 600;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 4px;
}

.urgency-label i {
    font-size: 0.7rem;
    animation: pulse 1.5s infinite;
}

@keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.4; }
    100% { opacity: 1; }
}

.product-card:hover {
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4), inset 0 0 0 1px rgba(249, 158, 26, 0.2);
    transform: translateY(-5px);
}

.product-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    cursor: pointer;
    transition: transform 0.5s ease;
}

.product-card:hover .product-img {
    transform: scale(1.05) translateZ(10px);
}

.product-info {
    padding: 20px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
}

.product-category {
    font-size: 0.8rem;
    color: var(--text-light);
    margin-bottom: 5px;
}

.product-title {
    font-size: 1.1rem;
    margin-bottom: 10px;
    cursor: pointer;
}

.product-title:hover {
    color: var(--accent-color);
}

.product-price {
    font-size: 1.2rem;
    font-weight: bold;
    color: var(--accent-color);
    margin-bottom: 15px;
    margin-top: auto;
}

.product-actions {
    display: flex;
    gap: 10px;
}

.product-actions button {
    flex: 1;
    padding: 12px 10px;
    font-size: 0.95rem;
    font-weight: 600;
    min-height: 44px;
}

/* Filter Bar */
.filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding: 15px 20px;
    background: var(--bg-light);
    border-radius: 8px;
    box-shadow: var(--shadow);
}

.filter-group {
    display: flex;
    align-items: center;
    gap: 10px;
}

.filter-group select {
    padding: 8px 12px;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    outline: none;
    font-family: inherit;
    cursor: pointer;
    background: var(--secondary-color);
    color: var(--text-color);
}

.empty-state {
    text-align: center;
    padding: 50px 20px;
    background: var(--bg-light);
    border-radius: 8px;
    box-shadow: var(--shadow);
}

/* Product Details */
.product-details-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    margin: 50px 0;
}

.product-gallery {
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow);
}

.product-gallery img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
    cursor: zoom-in;
}

.product-gallery img:hover {
    transform: scale(1.5);
}

.product-details-info h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
}

.product-details-price {
    font-size: 2rem;
    color: var(--accent-color);
    font-weight: bold;
    margin-bottom: 20px;
}

.product-details-desc {
    color: var(--text-light);
    margin-bottom: 30px;
    font-size: 1.1rem;
    line-height: 1.6;
}

.product-details-desc img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 10px 0;
}

.add-to-cart-large {
    width: 100%;
    padding: 15px;
    font-size: 1.1rem;
}

/* Cart Sidebar */
.cart-sidebar {
    position: fixed;
    top: 0;
    right: -400px;
    width: 400px;
    max-width: 100%;
    height: 100vh;
    background: var(--primary-color);
    box-shadow: -5px 0 15px rgba(0,0,0,0.5);
    z-index: 1001;
    transition: var(--transition);
    display: flex;
    flex-direction: column;
}

.cart-sidebar.open {
    right: 0;
}

.cart-header {
    padding: 20px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.close-cart {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--text-color);
}

.cart-items {
    flex-grow: 1;
    overflow-y: auto;
    padding: 20px;
}

.cart-item {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
}

.cart-item-img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
}

.cart-item-info {
    flex-grow: 1;
}

.cart-item-title {
    font-weight: 500;
    margin-bottom: 5px;
}

.cart-item-price {
    color: var(--accent-color);
    font-weight: bold;
    margin-bottom: 10px;
}

.cart-item-controls {
    display: flex;
    align-items: center;
    gap: 10px;
}

.qty-btn {
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    width: 25px;
    height: 25px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    color: var(--text-color);
}

.remove-item {
    color: #ff4444;
    background: none;
    border: none;
    cursor: pointer;
    margin-left: auto;
}

.cart-footer {
    padding: 20px;
    border-top: 1px solid var(--border-color);
}

.cart-total {
    display: flex;
    justify-content: space-between;
    font-size: 1.2rem;
    font-weight: bold;
    margin-bottom: 20px;
}

.checkout-btn {
    width: 100%;
    padding: 15px;
    background: var(--accent-color);
    color: white;
    border: none;
    font-size: 1.1rem;
    cursor: pointer;
    border-radius: 4px;
    font-weight: bold;
    transition: var(--transition);
    box-shadow: 0 0 10px rgba(249, 158, 26, 0.3);
}

.checkout-btn:hover {
    background: var(--accent-hover);
    box-shadow: 0 0 15px rgba(249, 158, 26, 0.6);
}

.cart-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 1000;
    display: none;
}

.cart-overlay.open {
    display: block;
}

/* Footer */
.footer {
    background-color: rgba(13, 17, 23, 0.95);
    padding: 80px 0 30px;
    margin-top: 60px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
}

.footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(249, 158, 26, 0.3), transparent);
}

.footer-container {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 50px;
    margin-bottom: 50px;
}

.footer-col h3 {
    color: var(--text-color);
    margin-bottom: 25px;
    font-size: 1.2rem;
    font-weight: 600;
    position: relative;
    display: inline-block;
    letter-spacing: 0.5px;
}

.footer-col h3::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 40px;
    height: 2px;
    background-color: var(--accent-color);
    border-radius: 2px;
}

.footer-col p {
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 20px;
    font-size: 0.95rem;
    line-height: 1.7;
}

.footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.footer-col ul li a {
    color: rgba(255, 255, 255, 0.7);
    transition: var(--transition);
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
}

.footer-col ul li a:hover {
    color: var(--accent-color);
    transform: translateX(5px);
}

.social-links {
    display: flex;
    gap: 15px;
    margin-top: 25px;
}

.social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--text-color);
    transition: var(--transition);
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.social-links a:hover {
    background-color: rgba(249, 158, 26, 0.1);
    color: var(--accent-color);
    border-color: rgba(249, 158, 26, 0.2);
    transform: translateY(-3px);
}

.newsletter-form {
    display: flex;
    margin-top: 20px;
}

.newsletter-form input {
    flex: 1;
    padding: 12px 15px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-color);
    border-radius: 6px 0 0 6px;
    outline: none;
    font-size: 0.9rem;
    transition: border-color 0.3s ease;
}

.newsletter-form input:focus {
    border-color: var(--accent-color);
}

.newsletter-form button {
    padding: 0 20px;
    background: var(--accent-color);
    color: #000;
    border: none;
    border-radius: 0 6px 6px 0;
    cursor: pointer;
    font-weight: 600;
    transition: var(--transition);
}

.newsletter-form button:hover {
    background: var(--accent-hover);
}

/* Payment Gateways */
.payment-gateways {
    margin: 40px auto 20px;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 30px;
}

.payment-gateways .trust-title {
    color: var(--text-light);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 20px;
    font-weight: 600;
}

.payment-gateways img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    filter: brightness(1) contrast(1);
    transition: var(--transition);
    padding: 10px;
    background: rgba(255, 255, 255, 0.02);
}

.payment-gateways img:hover {
    filter: brightness(1.1);
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.05);
}

/* Referral Banner in Footer */
.referral-footer-banner {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(245, 158, 11, 0.08) 100%);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: 20px;
    padding: 30px;
    margin-bottom: 50px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    overflow: hidden;
    position: relative;
    flex-wrap: wrap; /* Prevent overlap by allowing wrapping */
}

.referral-footer-banner::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 200px;
    height: 100%;
    background: radial-gradient(circle at top right, rgba(245, 158, 11, 0.1), transparent 70%);
    pointer-events: none;
}

.referral-content h3 {
    font-size: 1.5rem;
    margin-bottom: 10px;
    color: var(--accent-color);
}

.referral-content p {
    color: var(--text-light);
    margin: 0;
    font-size: 1rem;
}

.referral-footer-banner .btn {
    white-space: nowrap;
    padding: 15px 35px;
    flex-shrink: 0; /* Ensure button doesn't shrink and cut off text */
    z-index: 1;
}

@media (max-width: 768px) {
    .referral-footer-banner {
        flex-direction: column;
        text-align: center;
        padding: 25px;
    }
    
    .referral-footer-banner .btn {
        width: 100%;
    }
}

.footer-bottom {
    text-align: center;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9rem;
}

/* Static Pages */
.page-header {
    background: var(--bg-light);
    padding: 40px 0;
    text-align: center;
    margin-bottom: 40px;
}

.page-content {
    max-width: 800px;
    margin: 0 auto 60px;
}

.page-content h2 {
    margin: 30px 0 15px;
}

.page-content p {
    margin-bottom: 15px;
}

.contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.form-group input, .form-group textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    font-family: inherit;
    background: var(--bg-light);
    color: var(--text-color);
}

/* Checkout & Payment */
.checkout-container {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 30px;
    margin-bottom: 60px;
    align-items: start;
}

@media (max-width: 1024px) {
    .checkout-container {
        grid-template-columns: 1fr;
    }
    
    .checkout-sidebar {
        position: static !important;
    }
}

.checkout-main {
    display: flex;
    flex-direction: column;
}

.checkout-sidebar {
    position: sticky;
    top: 100px;
}

.payment-instructions {
    transition: var(--transition);
    animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
}

@media (max-width: 768px) {
    .contact-grid {
        grid-template-columns: 1fr;
    }
}

.checkout-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text-color);
}

.checkout-section-title i {
    color: var(--accent-color);
    background: rgba(245, 158, 11, 0.1);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    font-size: 1rem;
}

.payment-methods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 15px;
    margin-bottom: 20px;
}

.payment-method {
    border: 1px solid var(--border-color);
    padding: 15px 10px;
    border-radius: 16px;
    cursor: pointer;
    text-align: center;
    transition: var(--transition);
    font-weight: 600;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.02);
    position: relative;
    overflow: hidden;
}

.payment-method::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at top right, rgba(245, 158, 11, 0.1), transparent 70%);
    opacity: 0;
    transition: var(--transition);
}

.payment-method:hover {
    border-color: var(--accent-color);
    transform: translateY(-3px);
    box-shadow: 0 10px 20px -10px rgba(0,0,0,0.5);
}

.payment-method:hover::after {
    opacity: 1;
}

.payment-method.active {
    border-color: var(--accent-color);
    background: rgba(245, 158, 11, 0.05);
    box-shadow: inset 0 0 0 1px var(--accent-color);
}

.payment-method.active::before {
    content: '\f058';
    font-family: 'Font Awesome 5 Free';
    font-weight: 900;
    position: absolute;
    top: 8px;
    right: 8px;
    color: var(--accent-color);
    font-size: 0.9rem;
}

.payment-method.bkash { color: #e2136e; }
.payment-method.nagad { color: #f7931e; }
.payment-method.disabled {
    opacity: 0.4;
    cursor: not-allowed;
    filter: grayscale(1);
}

.payment-method.disabled:hover {
    transform: none;
    box-shadow: none;
    border-color: var(--border-color);
}
.payment-method.bank { color: #3399ff; }

.payment-instructions {
    background: var(--bg-light);
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 20px;
    border-left: 4px solid var(--accent-color);
    font-size: 1.1rem;
}

.order-summary-box {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 20px;
    background: var(--bg-light);
    position: sticky;
    top: 110px;
}

.summary-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--border-color);
}

.summary-total {
    display: flex;
    justify-content: space-between;
    font-size: 1.3rem;
    font-weight: bold;
    color: var(--accent-color);
    margin-top: 20px;
    padding-top: 20px;
    border-top: 2px solid var(--border-color);
}

/* 404 Error Page */
.error-page {
    text-align: center;
    padding: 100px 20px;
}

.error-page h1 {
    font-size: 6rem;
    color: var(--accent-color);
    margin-bottom: 10px;
}

.error-page h2 {
    font-size: 2rem;
    margin-bottom: 20px;
}

.error-page p {
    color: var(--text-light);
    margin-bottom: 30px;
}

/* Subcategories & Filter Pills */
.subcategories-pills {
    padding: 10px 5px 25px;
    margin-bottom: 25px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    border-bottom: 1px solid var(--border-color);
}

.subcategories-pills .btn {
    font-size: 0.9rem;
    padding: 8px 20px;
    border-radius: 30px;
    white-space: nowrap;
    flex-shrink: 0;
    min-height: auto;
}

.subcategories-pills .btn.active {
    background: var(--accent-gradient);
    color: #020617;
    border-color: var(--accent-color);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
}

@media (max-width: 768px) {
    .subcategories-pills {
        padding: 10px 5px 20px;
        margin-bottom: 20px;
        -webkit-overflow-scrolling: touch;
        flex-wrap: nowrap;
        justify-content: flex-start;
        overflow-x: auto;
        scrollbar-width: none;
        border-bottom: none;
    }
    
    .subcategories-pills::-webkit-scrollbar {
        display: none;
    }
    
    .subcategories-pills .btn {
        font-size: 0.8rem;
        padding: 6px 16px;
    }
}

/* Responsive */
@media (max-width: 1024px) {
    .products-grid {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
    }
    
    .hero h1 {
        font-size: 2.8rem;
    }
    
    .search-bar input {
        width: 150px;
    }
}

@media (max-width: 768px) {
    .mobile-search-toggle {
        display: block;
    }

    .hero {
        padding: 60px 0;
        text-align: center;
    }

    .hero h1 {
        font-size: 2rem;
        margin-bottom: 15px;
    }
    
    .hero p {
        font-size: 0.95rem;
        padding: 0 10px;
        margin-bottom: 25px;
    }

    .header-container {
        height: 70px;
    }

    .logo img {
        height: 50px;
    }

    #desktop-search {
        display: none;
    }

    .categories-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .category-card {
        padding: 15px 10px;
    }

    .category-card i {
        font-size: 1.5rem;
        margin-bottom: 8px;
    }

    .category-card h3 {
        font-size: 0.9rem;
    }

    .products-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .product-card {
        border-radius: 10px;
    }

    .product-img {
        height: 160px;
    }

    .product-info {
        padding: 12px;
    }

    .product-title {
        font-size: 0.9rem;
        margin-bottom: 8px;
        line-height: 1.3;
        height: 2.6em;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .product-price {
        font-size: 1.1rem;
        margin-bottom: 12px;
    }

    .header-icons {
        gap: 8px;
    }

    .header-icons button {
        min-width: 36px;
        min-height: 36px;
    }

    .mobile-search-toggle {
        display: flex !important;
    }

    #desktop-search {
        display: none !important;
    }

    .mobile-search-toggle {
        display: flex !important;
    }

    .header-icons {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .header-icons button {
        background: transparent;
        border: none;
        color: inherit;
        cursor: pointer;
        padding: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        min-height: 40px;
        transition: var(--transition);
        border-radius: 50%;
    }

    .header-icons button:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    
    .search-bar button {
        min-width: 44px;
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .nav-menu {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        background: rgba(26, 30, 36, 0.98);
        backdrop-filter: blur(16px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        flex-direction: column;
        padding: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        max-height: calc(100vh - 70px);
        overflow-y: auto;
        z-index: 1000;
    }

    .nav-menu.active {
        display: flex;
        animation: slideInDown 0.3s ease-out;
    }

    @keyframes slideInDown {
        from { transform: translateY(-20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .nav-menu > ul {
        flex-direction: column;
        gap: 15px;
    }

    .nav-menu a {
        font-size: 1.1rem;
        padding: 10px 0;
        display: block;
    }

    .dropdown-menu {
        position: static;
        box-shadow: none;
        padding-left: 20px;
        display: none;
        background: transparent;
        border: none;
    }
    
    .dropdown.active .dropdown-menu {
        display: flex;
    }

    .nested-dropdown-menu {
        position: static;
        box-shadow: none;
        padding-left: 20px;
        display: none;
        background: transparent;
        border: none;
        transform: none;
    }

    .nested-dropdown.active .nested-dropdown-menu {
        display: flex;
    }

    .mobile-menu-toggle {
        display: block;
    }

    .product-details-container {
        grid-template-columns: 1fr;
    }

    /* 2-Column Product Grid for Mobile */
    .products-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .product-info {
        padding: 10px;
    }

    .product-title {
        font-size: 0.95rem;
        height: 40px; /* Limit height for 2 lines */
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .product-price {
        font-size: 1rem;
    }

    .product-actions {
        flex-direction: column;
        gap: 8px;
    }

    .product-actions .btn {
        width: 100%;
        padding: 8px;
        font-size: 0.8rem;
    }

    .categories-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .category-card {
        padding: 15px 10px;
    }

    .category-card i {
        font-size: 1.8rem;
    }

    .checkout-container {
        grid-template-columns: 1fr;
    }
    
    .payment-methods {
        grid-template-columns: repeat(2, 1fr);
    }

    .cart-sidebar {
        width: 100%;
        right: -100%;
    }

    .footer-container {
        grid-template-columns: 1fr;
        gap: 40px;
        text-align: center;
    }

    .footer-col h3::after {
        left: 50%;
        transform: translateX(-50%);
    }

    .social-links {
        justify-content: center;
    }
}

/* Admin CSV Upload Styles */
#csv-upload-progress {
    animation: fadeIn 0.3s ease-in-out;
    display: flex;
    align-items: center;
    gap: 15px;
}

#csv-progress-text i {
    margin-right: 8px;
    animation: pulse 1.5s infinite;
}

@keyframes pulse {
    0% { opacity: 0.6; }
    50% { opacity: 1; }
    100% { opacity: 0.6; }
}

#csv-file-label:hover {
    background: var(--bg-light);
    border-color: var(--accent-color);
}

/* Skeleton Screens */
.skeleton {
    background: linear-gradient(90deg, #1e293b 25%, #2d3e5a 50%, #1e293b 75%);
    background-size: 200% 100%;
    animation: skeleton-loading 1.5s infinite linear;
    border-radius: 8px;
}

@keyframes skeleton-loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}

.product-card.skeleton-card {
    height: 380px;
    border: 1px solid rgba(255,255,255,0.03);
}

.skeleton-img {
    aspect-ratio: 1/1;
    width: 100%;
}

.skeleton-text {
    height: 20px;
    margin: 15px 10px;
    width: 80%;
}

.skeleton-price {
    height: 25px;
    margin: 5px 10px;
    width: 40%;
}

.skeleton-btn {
    height: 40px;
    margin: 10px;
    width: calc(100% - 20px);
}

.category-card.skeleton-cat {
    height: 140px;
}

/* Modal System */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    z-index: 1100;
    display: flex;
    justify-content: center;
    align-items: center;
    animation: fadeIn 0.3s ease;
}

.modal-content {
    background: var(--bg-light);
    width: 90%;
    max-width: 500px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    animation: slideUp 0.3s ease;
}

.modal-header {
    padding: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    justify-content: space-between;
    align-items: center;
}
/* Social Proof Notification */
#social-proof-container {
    position: fixed;
    bottom: 20px;
    left: 20px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: none;
}

.social-proof-pill {
    background: var(--bg-glass-heavy);
    backdrop-filter: blur(4px);
    border: 1px solid var(--border-color);
    padding: 12px 15px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: var(--shadow-premium);
    transform: translateX(-120%);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    max-width: 320px;
    pointer-events: auto;
}

.social-proof-pill.show {
    transform: translateX(0);
}

.social-proof-pill img {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    object-fit: cover;
}

.social-proof-pill p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.4;
}

.social-proof-pill small {
    font-size: 0.7rem;
    color: var(--accent-color);
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
}

/* Quick View Modal */
.quick-view-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(8px);
    z-index: 10000;
    display: none;
    justify-content: center;
    align-items: center;
}

.quick-view-content {
    background: var(--bg-light);
    width: 90%;
    max-width: 900px;
    max-height: 90vh;
    border-radius: 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    position: relative;
    border: 1px solid var(--border-color);
}

.quick-view-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    background: rgba(0,0,0,0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
}

@media (max-width: 768px) {
    .quick-view-content {
        grid-template-columns: 1fr;
        overflow-y: auto;
    }
}

.modal-header h2 {
    margin: 0;
    font-size: 1.25rem;
    color: white;
}

.close-modal {
    background: transparent;
    border: none;
    color: var(--text-light);
    font-size: 1.5rem;
    cursor: pointer;
    transition: var(--transition);
}

.close-modal:hover {
    color: white;
}

.modal-body {
    padding: 24px;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.9rem;
    color: var(--text-light);
}

.form-group input, .form-group select {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: white;
    font-size: 1rem;
    transition: var(--transition);
}

.form-group input:focus {
    outline: none;
    border-color: var(--accent-color);
    background: rgba(255, 255, 255, 0.08);
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes slideUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}

/* Toast Notification */
.toast-notification {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: var(--accent-gradient, #f59e0b);
    color: white;
    padding: 12px 25px;
    border-radius: 50px;
    font-weight: 600;
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    z-index: 10000;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
}

.toast-notification.show {
    transform: translateX(-50%) translateY(0);
}

/* Trending & Highlight Sections */
.section-header p {
    color: var(--text-light);
    font-size: 0.95rem;
}

@media (max-width: 768px) {
    .section-header {
        flex-direction: column;
        align-items: flex-start !important;
        gap: 10px;
    }
    
    .section-header button {
        width: 100%;
        margin-top: 5px;
    }
}

/* Sticky Mobile Bar */
.mobile-sticky-actions {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: var(--bg-glass-heavy);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 12px 20px;
    border-top: 1px solid var(--border-color);
    z-index: 1000;
    gap: 12px;
    box-shadow: 0 -10px 25px rgba(0,0,0,0.3);
}

@media (max-width: 768px) {
    .mobile-sticky-actions {
        display: flex;
    }
    
    .product-details-container {
        padding-bottom: 80px; /* Space for sticky bar */
    }
}

/* Quick View Modal Context Adjustments */
#quick-view-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(5px);
    z-index: 2000;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.qv-content {
    background: var(--bg-light);
    width: 100%;
    max-width: 900px;
    max-height: 90vh;
    border-radius: 20px;
    border: 1px solid var(--border-color);
    position: relative;
    overflow-y: auto;
    display: flex;
    gap: 30px;
    padding: 30px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    animation: slideUp 0.4s ease;
}

@media (max-width: 800px) {
    .qv-content {
        flex-direction: column;
        padding: 20px;
        gap: 15px;
    }
    
    .qv-content > div {
        max-width: 100% !important;
    }
}

.qv-close {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 36px;
    height: 36px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s;
}

.qv-close:hover {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
}

/* Out of Stock Styling */
.product-card.out-of-stock {
    position: relative;
}

.product-card.out-of-stock::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 23, 42, 0.2);
    pointer-events: none;
    z-index: 2;
    border-radius: 20px;
}

/* Trust Badges Enhancement */
.trust-badges {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 60px;
}

.trust-item {
    background: var(--bg-glass);
    backdrop-filter: blur(10px);
    padding: 25px;
    border-radius: 16px;
    text-align: center;
    border: 1px solid var(--border-color);
    transition: var(--transition);
}

.trust-item:hover {
    transform: translateY(-3px);
    border-color: var(--accent-color);
    box-shadow: var(--shadow-premium);
}

.trust-item i {
    font-size: 2.5rem;
    color: var(--accent-color);
    margin-bottom: 15px;
    display: block;
}

.trust-item h3 {
    font-size: 1.1rem;
    margin-bottom: 8px;
    color: white;
}

.trust-item p {
    font-size: 0.9rem;
    color: var(--text-light);
    margin: 0;
}

/* Policy Content Styling */
.policy-container {
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.8;
}

.policy-container h2 {
    color: var(--accent-color);
    margin: 30px 0 15px 0;
    font-size: 1.5rem;
}

.policy-container p {
    margin-bottom: 20px;
    color: var(--text-light);
}

.policy-container ul {
    margin-bottom: 20px;
    padding-left: 20px;
}

/* Flash Sale Styles */
.flash-sale-banner {
    background: linear-gradient(90deg, #ff7a18, #ffb347);
    color: white;
    padding: 25px;
    border-radius: 20px;
    margin: 40px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 10px 30px rgba(255, 122, 24, 0.3);
    position: relative;
    overflow: hidden;
}

.flash-sale-banner::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
    animation: rotate 10s linear infinite;
    pointer-events: none;
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.flash-sale-info h2 {
    font-size: 2rem;
    margin: 0;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.flash-sale-timer {
    display: flex;
    gap: 15px;
    align-items: center;
}

.timer-box {
    background: rgba(0, 0, 0, 0.2);
    padding: 10px 15px;
    border-radius: 10px;
    text-align: center;
    min-width: 70px;
}

.timer-num {
    font-size: 1.8rem;
    font-weight: 700;
    display: block;
}

.timer-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    opacity: 0.8;
}

/* Product Card Hover Enhancements */
.product-card {
    background: var(--bg-card);
    transition: var(--transition);
}

.product-card:hover {
    transform: translateY(-10px);
    box-shadow: var(--shadow-premium);
    border-color: var(--accent-color);
}

.product-card:hover .product-img img {
    transform: scale(1.1);
}

.product-card:hover .quick-view-overlay {
    opacity: 1;
}

/* Social Proof Styles */
.social-proof-section {
    padding: 60px 0;
    background: rgba(245, 158, 11, 0.02);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    margin: 40px 0;
}

.social-proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    text-align: center;
}

.proof-item h2 {
    font-size: 2.5rem;
    color: var(--accent-color);
    margin-bottom: 5px;
}

.proof-item p {
    color: var(--text-light);
    font-weight: 500;
}

/* Mobile Sticky Add to Cart */
.mobile-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--bg-glass-heavy);
    backdrop-filter: blur(4px);
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 1000;
    border-top: 1px solid var(--border-color);
    transform: translateY(100%);
    transition: transform 0.4s ease;
}

.mobile-sticky-bar.active {
    transform: translateY(0);
}

.sticky-price {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--accent-color);
}

/* Exit Intent Popup */
.exit-popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(5px);
    z-index: 9999;
    display: none;
    justify-content: center;
    align-items: center;
}

.exit-popup-content {
    background: var(--bg-card);
    padding: 40px;
    border-radius: 20px;
    max-width: 500px;
    width: 90%;
    text-align: center;
    border: 1px solid var(--accent-color);
    position: relative;
    animation: popIn 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes popIn {
    from { transform: scale(0.8); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}

/* Order Tracking Page Styles */
.tracking-stepper {
    display: flex;
    justify-content: space-between;
    margin: 40px 0;
    position: relative;
}

.tracking-stepper::before {
    content: '';
    position: absolute;
    top: 25px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--border-color);
    z-index: 0;
}

.step-item {
    position: relative;
    z-index: 1;
    text-align: center;
    flex: 1;
}

.step-dot {
    width: 50px;
    height: 50px;
    background: var(--bg-light);
    border: 2px solid var(--border-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 10px;
    transition: var(--transition);
}

.step-item.active .step-dot {
    background: var(--accent-color);
    border-color: var(--accent-color);
    color: white;
}

.step-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-light);
}

.step-item.active .step-label {
    color: white;
}

/* SEO Content Block */
/* Skeleton UI Shimmer */
.skeleton-shimmer {
    background: linear-gradient(90deg, #111827 25%, #1f2937 50%, #111827 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite linear;
}

.skeleton-container {
    min-height: auto !important;
}

.hero + section, .hero-section + section {
    margin-top: 30px !important;
    padding-top: 30px !important;
}

section, .section, .section-lg, .section-xl, .section-block {
    min-height: auto !important;
}

@keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
}

/* Variant Pills */
.variant-selector {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
}

.variant-pill {
    padding: 8px 16px;
    border: 1px solid var(--border-color);
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.03);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    transition: var(--transition);
    user-select: none;
}

.variant-pill.active {
    background: var(--accent-color);
    border-color: var(--accent-color);
    color: white;
}

.variant-pill:hover:not(.active) {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--text-light);
}

/* Mini Cart Drawer */
.mini-cart-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(5px);
    z-index: 2000;
    visibility: hidden;
    opacity: 0;
    transition: all 0.4s ease;
}

.mini-cart-overlay.active {
    visibility: visible;
    opacity: 1;
}

.mini-cart-drawer {
    position: fixed;
    top: 0;
    right: -400px;
    width: 100%;
    max-width: 400px;
    height: 100%;
    background: var(--secondary-color);
    z-index: 2001;
    transition: right 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.5);
    border-left: 1px solid var(--border-color);
}

.mini-cart-overlay.active .mini-cart-drawer {
    right: 0;
}

.mini-cart-header {
    padding: 20px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.mini-cart-content {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
}

.mini-cart-footer {
    padding: 20px;
    border-top: 1px solid var(--border-color);
    background: rgba(255, 255, 255, 0.02);
}

/* Product Zoom */
.product-img-zoom-container {
    overflow: hidden;
    border-radius: 12px;
    cursor: zoom-in;
    position: relative;
}

.product-img-zoom-container img {
    transition: transform 0.3s ease;
}

.product-img-zoom-container:hover img {
    transform: scale(1.5);
}

/* Notification Toast Refinement */
.toast-stack {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.toast-msg {
    background: var(--bg-card);
    color: white;
    padding: 12px 20px;
    border-radius: 10px;
    border-left: 4px solid var(--accent-color);
    box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    animation: slideInRight 0.4s ease forwards;
    display: flex;
    align-items: center;
    gap: 12px;
}

@keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}

/* Logo Minimal Style */
.clean-logo {
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: -1px;
    color: white;
    text-transform: uppercase;
}

.clean-logo span {
    color: var(--accent-color);
}

/* Affiliate Page Styles */
.affiliate-hero {
    padding: 100px 0;
    text-align: center;
    background: radial-gradient(circle at center, rgba(245, 158, 11, 0.05) 0%, transparent 70%);
}

.affiliate-hero h1 {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 20px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
}

.earning-badge {
    display: inline-block;
    background: rgba(245, 158, 11, 0.1);
    color: var(--accent-color);
    padding: 10px 25px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 30px;
    border: 1px solid rgba(245, 158, 11, 0.2);
}

.affiliate-section {
    padding: 80px 0;
}

.section-tag {
    color: var(--accent-color);
    text-transform: uppercase;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 2px;
    display: block;
    margin-bottom: 15px;
    text-align: center;
}

.affiliate-section h2 {
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: 50px;
}

/* Steps */
.steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
}

.step-card {
    background: rgba(255, 255, 255, 0.02);
    padding: 40px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
    transition: var(--transition);
}

.step-card:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--accent-color);
    transform: translateY(-10px);
}

.step-number {
    width: 50px;
    height: 50px;
    background: var(--accent-color);
    color: #020617;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.2rem;
    margin: 0 auto 25px;
}

/* Benefits Grid */
.benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.benefit-card {
    background: var(--bg-card);
    padding: 30px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 20px;
    border: 1px solid var(--border-color);
    transition: var(--transition);
}

.benefit-card:hover {
    border-color: rgba(245, 158, 11, 0.3);
    transform: scale(1.02);
}

.benefit-icon {
    width: 52px;
    height: 52px;
    min-width: 52px;
    background: rgba(245, 158, 11, 0.03);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-color);
    border: 1px solid rgba(245, 158, 11, 0.1);
    transition: var(--transition);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.05);
}

.benefit-card:hover .benefit-icon {
    background: rgba(245, 158, 11, 0.08);
    transform: scale(1.1);
    box-shadow: 0 0 25px rgba(245, 158, 11, 0.15);
}

.benefit-icon svg {
    width: 24px;
    height: 24px;
    stroke-width: 2px;
}

/* Milestone Cards */
.milestones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 25px;
}

.milestone-card {
    background: rgba(255, 255, 255, 0.03);
    padding: 30px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
    transition: var(--transition);
}

.milestone-card.premium {
    border-color: var(--accent-color);
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.05) 0%, transparent 100%);
    box-shadow: 0 10px 40px rgba(245, 158, 11, 0.1);
}

.milestone-card .badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--accent-color);
    color: #020617;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
}

.milestone-orders {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 5px;
}

.milestone-bonus {
    color: var(--accent-color);
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 15px;
}

.milestone-extra {
    font-size: 0.9rem;
    color: var(--text-light);
}

/* Payment & Join */
.join-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
}

.payment-methods {
    display: flex;
    gap: 20px;
    margin-top: 30px;
}

.payment-tag {
    background: var(--bg-card);
    padding: 15px 25px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
}

@media (max-width: 992px) {
    .steps-grid, .benefits-grid { grid-template-columns: 1fr; }
    .affiliate-hero h1 { font-size: 2.5rem; }
    .join-grid { grid-template-columns: 1fr; text-align: center; }
    .payment-methods { justify-content: center; flex-wrap: wrap; }
}




/* GUARANTEED HERO & LAYOUT GAP FIXES */
.hero, .hero-section, .hero-wrapper, .banner, .section-hero {
    min-height: 420px !important;
    height: auto !important;
    padding: 60px 0 40px 0 !important;
    display: flex !important;
    align-items: center !important;
}

.hero::after { display: none !important; }

/* Force remove gap after hero */
.hero + *, .hero-section + *, .hero + section, .hero + .container {
    margin-top: 0 !important;
    padding-top: 30px !important;
}

/* FIX skeleton causing huge gap */
.skeleton-container {
    margin-top: 0 !important;
    padding-top: 20px !important;
    min-height: auto !important;
}

.skeleton-card {
    height: 260px !important;
}

.category-card.skeleton-cat {
    height: 120px !important;
}

/* Remove empty sections that take up space */
section:empty, .section:empty, div:empty {
    display: none !important;
}

#flash-sale:empty, #social-proof:empty, #flash-sale-container:empty {
    display: none !important;
}

/* Global section height fix */
section, .section {
    min-height: auto !important;
    padding-top: 40px !important;
    padding-bottom: 40px !important;
}

/* Container & Main spacing normalization */
.container, main {
    margin-top: 0 !important;
    padding-top: 0 !important;
}

main > section:first-child {
    margin-top: 0 !important;
}

.flash-sale-banner {
    margin-top: 20px !important;
}

/* Admin Dashboard Premium Styles */
.admin-layout {
    font-family: 'Inter', sans-serif;
}

.admin-nav-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 12px 20px;
    margin: 4px 10px;
    border-radius: 12px;
    color: rgba(255,255,255,0.6);
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 0.9rem;
    font-weight: 500;
}

.admin-nav-item:hover {
    background: rgba(255,255,255,0.05);
    color: white;
}

.admin-nav-item.active {
    background: var(--accent-gradient);
    color: #020617;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.2);
}

.admin-nav-item i {
    width: 20px;
    text-align: center;
    font-size: 1.1rem;
}

/* Admin Workspace Enhancements */
.admin-workspace-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    gap: 20px;
}

.admin-search-container {
    position: relative;
    flex-grow: 1;
    max-width: 400px;
}

.admin-search-container i {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-light);
}

.admin-search-input {
    width: 100%;
    padding: 12px 15px 12px 45px;
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    color: white;
    font-size: 0.9rem;
    transition: all 0.3s ease;
}

.admin-search-input:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.1);
    outline: none;
}

.status-filters {
    display: flex;
    gap: 10px;
    margin-bottom: 25px;
    flex-wrap: wrap;
}

.filter-chip {
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    border-radius: 30px;
    color: var(--text-light);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
    font-weight: 600;
}

.filter-chip:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
}

.filter-chip.active {
    background: var(--accent-gradient);
    border-color: transparent;
    color: #020617;
}

.admin-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 8px;
    margin-top: -8px;
}

.admin-table th {
    padding: 15px 20px;
    text-align: left;
    color: var(--text-light);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
}

.admin-table tr {
    transition: all 0.2s ease;
}

.admin-table tbody tr {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
}

.admin-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.04);
    transform: scale(1.002);
}

.admin-table td {
    padding: 15px 20px;
}

.admin-table td:first-child {
    border-radius: 12px 0 0 12px;
}

.admin-table td:last-child {
    border-radius: 0 12px 12px 0;
}

.status-badge-premium {
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.status-pending { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
.status-processing { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
.status-delivered { background: rgba(16, 185, 129, 0.1); color: #10b981; }
.status-cancelled { background: rgba(239, 68, 68, 0.1); color: #ef4444; }

@media (max-width: 1024px) {
    .admin-sidebar {
        width: 80px;
    }
    .admin-sidebar span, .admin-sidebar p {
        display: none;
    }
    .admin-nav-item {
        justify-content: center;
        padding: 12px;
    }
    .admin-nav-item i {
        font-size: 1.3rem;
        margin: 0;
    }
}

.admin-main {
    background: #020617;
    background-image: 
        radial-gradient(at 100% 0%, rgba(245, 158, 11, 0.05) 0, transparent 40%),
        radial-gradient(at 0% 100%, rgba(15, 23, 42, 0.4) 0, transparent 40%);
}

.skeleton-card {
    background: rgba(255,255,255,0.03);
    border-radius: 20px;
    border: 1px solid var(--border-color);
    position: relative;
    overflow: hidden;
}

.skeleton-card::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    transform: translateX(-100%);
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.03), transparent);
    animation: skeleton-wave 2s infinite;
}

@keyframes skeleton-wave {
    100% { transform: translateX(100%); }
}

/* Fix for existing components in admin */
.admin-main .btn-outline {
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border-color);
    color: var(--text-light);
}

.admin-main .btn-outline:hover {
    border-color: var(--accent-color);
    color: var(--accent-color);
    background: rgba(245, 158, 11, 0.05);
}

/* Mobile Admin Responsiveness */
@media (max-width: 992px) {
    .admin-layout {
        flex-direction: column !important;
    }
    .admin-sidebar {
        width: 100% !important;
        height: auto !important;
        position: static !important;
        border-right: none !important;
        border-bottom: 1px solid rgba(255,255,255,0.05) !important;
    }
    .admin-sidebar > div:nth-child(2) {
        display: flex !important;
        overflow-x: auto !important;
        padding: 10px !important;
        gap: 10px !important;
    }
    .admin-sidebar > div:nth-child(2) p {
        display: none !important;
    }
    .admin-nav-item {
        white-space: nowrap !important;
        margin-bottom: 0 !important;
        padding: 10px 15px !important;
    }
    .admin-main {
        padding: 20px !important;
    }
    .admin-main #admin-dashboard-widgets > div {
        grid-template-columns: 1fr !important;
    }
}

/* Mobile Sticky Action Bar */
.mobile-sticky-action-bar {
    display: none;
    position: fixed;
    bottom: 15px;
    left: 15px;
    right: 15px;
    width: calc(100% - 30px);
    background: rgba(11, 18, 32, 0.95);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    padding: 12px;
    border-radius: 20px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.1);
    z-index: 990;
    gap: 12px;
}

.mobile-sticky-action-bar .btn {
    border-radius: 14px;
    font-weight: 600;
    padding: 12px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    transition: all 0.2s ease;
}

.mobile-sticky-action-bar .btn:active {
    transform: scale(0.96);
}

@media (max-width: 768px) {
    .mobile-sticky-action-bar {
        display: flex;
    }
    .product-actions {
        display: none !important;
    }
    .product-details-container {
        padding-bottom: 90px !important;
    }
}

/* New Background Layering */
.bg-dark { background-color: #0f172a; border-radius: 20px;}
.bg-gradient-red { background: linear-gradient(135deg, #450a0a, #7f1d1d); border-radius: 20px;}
.bg-glass { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(10px); border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05); border-radius: 20px;}
.bg-gray { background-color: #1e293b; border-radius: 20px;}

/* Large Search Bar */
.large-search-container { max-width: 800px; margin: -35px auto 40px; position: relative; z-index: 10; padding: 0 20px; }
.large-search-bar { display: flex; align-items: center; background: #1e293b; border: 2px solid var(--accent-color); border-radius: 50px; padding: 5px 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
.large-search-bar input { flex-grow: 1; background: transparent; border: none; color: white; font-size: 1.1rem; outline: none; padding: 10px; margin-left: 10px;}
.large-search-bar button { background: var(--accent-color); color: #000; border: none; padding: 12px 30px; border-radius: 50px; font-weight: bold; cursor: pointer; font-size: 1.0rem; transition: background 0.3s;}
.large-search-bar button:hover { background: #d97706; }
.trending-searches { text-align: center; margin-top: 15px; font-size: 0.9rem; color: var(--text-light); }
.trending-searches span { display: inline-block; background: rgba(255,255,255,0.1); padding: 5px 12px; border-radius: 20px; margin: 4px; cursor: pointer; transition: 0.3s; }
.trending-searches span:hover { background: var(--accent-color); color: #000; }

/* Product Card Upgrades */
.discount-badge { position: absolute; top: 12px; left: 12px; background: #ef4444; color: white; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: bold; z-index: 10; box-shadow: 0 4px 10px rgba(239, 68, 68, 0.4); }
.product-rating { display: flex; align-items: center; gap: 5px; font-size: 0.85rem; color: #f59e0b; margin-bottom: 5px; }
.product-sold { font-size: 0.8rem; color: var(--text-light); margin-bottom: 8px; }
.old-price { text-decoration: line-through; color: var(--text-light); font-size: 0.9rem; margin-left: 8px; font-weight: normal; }
.product-actions-vertical { display: flex; flex-direction: column; gap: 10px; margin-top: 15px; }
.product-actions-vertical .btn { width: 100%; justify-content: center; }

/* Brand Identity Section */
.features-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    padding: 50px 20px;
    background: rgba(30, 41, 59, 0.5);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    margin-bottom: 60px;
}
.feature-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    color: var(--text-color);
}
.feature-item i {
    font-size: 2.2rem;
    color: var(--accent-color);
}
.feature-item h4 {
    margin: 0 0 5px 0;
    font-size: 1.1rem;
    font-weight: 600;
}
.feature-item p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-light);
}

/* Bottom Navigation (Mobile) */
.bottom-nav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: var(--surface-light);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    z-index: 1000;
    justify-content: space-around;
    padding: 10px 0 15px 0;
    backdrop-filter: blur(10px);
}
.bottom-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--text-light);
    text-decoration: none;
    font-size: 0.75rem;
    gap: 5px;
    transition: all 0.3s ease;
}
.bottom-nav-item svg {
    opacity: 0.7;
    transition: all 0.3s ease;
}
.bottom-nav-item.active {
    color: var(--accent-color);
}
.bottom-nav-item.active svg {
    opacity: 1;
    transform: translateY(-2px);
}
.bottom-nav-badge {
    position: absolute;
    top: -5px;
    right: -8px;
    background: var(--accent-color);
    color: white;
    font-size: 0.65rem;
    font-weight: bold;
    min-width: 16px;
    height: 16px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
}

@media (max-width: 768px) {
    .bottom-nav {
        display: flex;
    }
    .desktop-only {
        display: none !important;
    }
    body {
        padding-bottom: 70px;
    }
    .header-actions-wrapper .search-bar {
        display: none !important;
    }
}
@media (min-width: 769px) {
    #desktop-search {
        display: flex !important;
    }
}

/* ==========================================================
   PREMIUM UI/UX REVAMP (Apple x Nike x Amazon Style)
   ========================================================== */

/* --- 1. Whitespace & Typography --- */
section, .section, .container > section {
    padding: 80px 0 !important;
    margin-bottom: 0 !important;
}

.section-title {
    font-size: 2.2rem !important;
    font-weight: 700 !important;
    letter-spacing: -0.5px;
    margin-bottom: 10px !important;
}

.section-header p {
    font-size: 1.1rem !important;
    color: var(--text-light) !important;
}

/* --- 2. Alternating Backgrounds for Depth --- */
.bg-alternate {
    background-color: #081120 !important; /* Slightly darker than default #020617 */
    border-top: 1px solid rgba(255,255,255,0.02);
    border-bottom: 1px solid rgba(255,255,255,0.02);
}

/* --- 3. Hero Transition Divider --- */
.hero-bottom-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 150px;
    background: linear-gradient(to top, var(--secondary-color) 0%, transparent 100%);
    z-index: 2;
    pointer-events: none;
}
.hero {
    position: relative;
    padding-bottom: 80px !important;
}

/* --- 4. Premium Category Cards --- */
.category-card {
    background: rgba(30, 41, 59, 0.4) !important;
    border-radius: 20px !important;
    padding: 30px 15px !important;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2) !important;
    border: 1px solid rgba(255,255,255,0.05) !important;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
}
.category-card:hover {
    transform: translateY(-8px) scale(1.02) !important;
    background: rgba(30, 41, 59, 0.8) !important;
    border-color: var(--accent-color) !important;
    box-shadow: 0 15px 35px rgba(0,0,0,0.4), 0 0 20px rgba(245, 158, 11, 0.15) !important;
}
.category-card i {
    font-size: 3rem !important;
    color: var(--text-color) !important;
}
.category-card:hover i {
    color: var(--accent-color) !important;
}
.category-card h3 {
    font-size: 1.1rem !important;
    font-weight: 600 !important;
}

/* --- 5. Uniform Product Cards --- */
.product-card {
    height: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    border-radius: 16px !important;
}
.product-img {
    height: auto !important;
    aspect-ratio: 1 / 1 !important;
    object-fit: cover !important;
    width: 100% !important;
    background-color: #111827; /* Dark fallback */
}
.product-info {
    flex-grow: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    padding: 20px !important;
}
.product-title {
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
    height: 48px !important; /* Fixed height for 2 lines */
    font-size: 1.05rem !important;
    line-height: 1.4 !important;
    margin-bottom: 12px !important;
}
.product-price-container {
    margin-top: auto !important;
}
.product-btn {
    margin-top: 15px !important;
    width: 100% !important;
    padding: 12px !important;
    font-weight: 600 !important;
    border-radius: 12px !important;
}

/* --- 6. Grid Layout Updates (Responsive) --- */
.products-grid {
    display: grid !important;
    gap: 24px !important;
    /* Default for very large desktop */
    grid-template-columns: repeat(5, 1fr) !important;
}

@media (max-width: 1400px) {
    .products-grid {
        grid-template-columns: repeat(4, 1fr) !important;
    }
}
@media (max-width: 1024px) {
    .products-grid {
        grid-template-columns: repeat(3, 1fr) !important;
    }
}
@media (max-width: 768px) {
    .products-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 16px !important;
    }
    .product-info {
        padding: 15px !important;
    }
    section, .section, .container > section {
        padding: 50px 0 !important;
    }
    .section-title {
        font-size: 1.8rem !important;
    }
}

/* --- 7. Search Prominence --- */
.large-search-container {
    margin-top: -35px !important;
    margin-bottom: 60px !important;
    position: relative;
    z-index: 10;
}
.large-search-bar {
    max-width: 800px !important;
    margin: 0 auto;
    background: rgba(15, 23, 42, 0.95) !important;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1) !important;
    border-radius: 30px !important;
    padding: 8px 12px !important;
    box-shadow: 0 15px 35px rgba(0,0,0,0.4) !important;
}
.large-search-bar input {
    font-size: 1.1rem !important;
    padding: 15px 20px !important;
}
.large-search-bar button {
    padding: 12px 30px !important;
    font-size: 1.1rem !important;
    border-radius: 25px !important;
}

/* --- 8. CTAs / Buttons --- */
.btn {
    border-radius: 12px;
    font-weight: 600;
    transition: all 0.3s ease;
}
.btn-outline {
    background: transparent !important;
    border: 2px solid rgba(255,255,255,0.2) !important;
    color: white !important;
}
.btn-outline:hover {
    border-color: white !important;
    background: rgba(255,255,255,0.05) !important;
}

/* --- 9. Statistics Cards (Why CSGO) --- */
.stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 30px 20px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    transition: transform 0.3s ease;
}
.stat-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255,255,255,0.2);
}
.stat-icon {
    font-size: 2.5rem;
    margin-bottom: 15px;
    color: var(--accent-color);
}
.stat-value {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 5px;
}
.stat-label {
    font-size: 0.95rem;
    color: var(--text-light);
}

/* --- Header Shrinking --- */
.header {
    transition: height 0.3s ease, background 0.3s ease;
}
.header.scrolled {
    height: 60px;
    background: rgba(13, 17, 23, 0.95);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
}
.header.scrolled .clean-logo {
    font-size: 1.5rem;
}

/* ==========================================================
   BLUEPRINT PHASE 1: HERO, CATEGORIES & FLASH SALE
   ========================================================== */

/* --- 1. Premium Hero --- */
.premium-hero {
    position: relative;
    background: var(--secondary-color);
    overflow: hidden;
    padding: 0 !important;
}

.hero-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 580px;
    position: relative;
    z-index: 2;
}

.hero-left {
    flex: 1;
    max-width: 600px;
    padding: 60px 0;
}

.hero-right {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    position: relative;
}

.hero-image-wrapper {
    position: relative;
    width: 100%;
    max-width: 500px;
}

.hero-img-animated {
    width: 100%;
    height: auto;
    border-radius: 20px;
    animation: slowZoom 20s infinite alternate linear;
    position: relative;
    z-index: 2;
}

.hero-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    height: 80%;
    background: radial-gradient(circle, var(--accent-color) 0%, transparent 70%);
    opacity: 0.3;
    filter: blur(50px);
    z-index: 1;
    animation: pulseGlow 4s infinite alternate;
}

@keyframes slowZoom {
    0% { transform: scale(1); }
    100% { transform: scale(1.1); }
}

@keyframes pulseGlow {
    0% { opacity: 0.2; transform: translate(-50%, -50%) scale(0.9); }
    100% { opacity: 0.4; transform: translate(-50%, -50%) scale(1.1); }
}

.hero-title {
    font-size: 3.5rem;
    line-height: 1.1;
    margin-bottom: 20px;
    font-weight: 800;
}

.hero-desc {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: 30px;
    line-height: 1.6;
}

.hero-btns {
    display: flex;
    gap: 15px;
}

/* Trust Cards (Hero Bottom) */
.trust-cards-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding: 30px 20px;
    position: relative;
    z-index: 3;
    background: rgba(13, 17, 23, 0.6);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    margin-top: -80px;
}

.trust-card {
    display: flex;
    align-items: center;
    gap: 15px;
}

.trust-icon {
    font-size: 2rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 15px;
    border-radius: 12px;
}

.trust-info h4 {
    margin: 0 0 5px 0;
    font-size: 1.1rem;
}

.trust-info p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-light);
}

/* --- 2. Quick Categories (Premium Cards) --- */
.quick-categories-section {
    padding: 80px 20px;
}

.premium-categories .category-card {
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.8)) !important;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2) !important;
    border-radius: 20px !important;
    padding: 25px 15px !important;
    transition: all 0.3s ease !important;
}

.premium-categories .category-card:hover {
    background: linear-gradient(145deg, rgba(40, 51, 69, 0.8), rgba(25, 33, 52, 0.9)) !important;
    transform: translateY(-10px) !important;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(245, 166, 35, 0.2) !important;
    border-color: var(--accent-color) !important;
}

/* --- 3. Flash Sale Countdown --- */
.flash-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.countdown-timer {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 20px;
}

.time-box {
    background: #ef4444;
    color: white;
    font-weight: bold;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 1.1rem;
    box-shadow: 0 4px 10px rgba(239, 68, 68, 0.3);
}

.countdown-timer .colon {
    font-weight: bold;
    font-size: 1.2rem;
    color: var(--text-color);
}

.products-horizontal-slider {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding-bottom: 20px;
    scrollbar-width: none; /* Firefox */
}
.products-horizontal-slider::-webkit-scrollbar {
    display: none; /* Chrome */
}
.products-horizontal-slider > * {
    min-width: 280px;
    flex-shrink: 0;
}

/* --- Responsive Adjustments --- */
@media (max-width: 992px) {
    .hero-container {
        flex-direction: column;
        text-align: center;
        padding-top: 40px;
    }
    
    .hero-title {
        font-size: 2.5rem;
    }
    
    .hero-btns {
        justify-content: center;
    }
    
    .hero-right {
        margin-top: 40px;
        justify-content: center;
    }
    
    .trust-cards-container {
        grid-template-columns: repeat(2, 1fr);
        margin-top: 0;
        border-top: none;
    }
}

@media (max-width: 768px) {
    .hero-container {
        min-height: 420px;
    }
    
    .flash-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }
    
    .countdown-timer {
        margin-left: 0;
    }
    
    .trust-cards-container {
        grid-template-columns: 1fr;
    }
}

/* --- Phase 2: Premium Product Cards --- */
.product-card.premium-card {
    background: #0F172A !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    border-radius: 20px !important;
    padding: 0 !important;
    overflow: hidden;
    display: flex !important;
    flex-direction: column !important;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    position: relative;
    height: 100% !important;
}

.product-card.premium-card:hover {
    transform: translateY(-6px) !important;
    border-color: rgba(245, 166, 35, 0.3) !important;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(245, 166, 35, 0.1) !important;
}

.product-img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #020617; /* Darker background behind image */
    cursor: pointer;
}

.product-img-wrapper img.product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.product-card.premium-card:hover .product-img-wrapper img.product-img {
    transform: scale(1.08);
}

.premium-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}

.discount-badge {
    background: rgba(239, 68, 68, 0.85); /* Red for deals */
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.regular-badge {
    background: rgba(245, 166, 35, 0.85); /* Accent for trending/new */
    color: #020617;
    border: 1px solid rgba(255, 255, 255, 0.3);
}

.wishlist-btn-overlay {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    transition: all 0.3s ease;
}

.wishlist-btn-overlay:hover {
    background: rgba(245, 166, 35, 0.2);
    color: #F5A623;
}
.wishlist-btn-overlay.active {
    color: #EF4444;
}

.product-info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.product-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    font-size: 0.8rem;
}

.product-rating {
    display: flex;
    align-items: center;
    gap: 4px;
}
.text-accent {
    color: #F5A623;
}
.product-sold {
    color: #94A3B8;
}

.product-category-label {
    font-size: 0.75rem;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
    font-weight: 600;
}

.product-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: white;
    margin: 0 0 12px 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    cursor: pointer;
    transition: color 0.2s ease;
}

.product-card.premium-card:hover .product-title {
    color: #F5A623;
}

.product-price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 12px;
}

.current-price {
    font-size: 1.15rem;
    font-weight: 700;
    color: #F5A623;
}

.old-price {
    font-size: 0.85rem;
    color: #64748B;
    text-decoration: line-through;
}

.trust-indicators {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
}

.trust-badge {
    font-size: 0.7rem;
    padding: 4px 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    color: #CBD5E1;
    display: flex;
    align-items: center;
    gap: 4px;
}

.product-actions-grid {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 8px;
    margin-top: auto;
}

.btn-outline-premium {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.15);
    color: white;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    height: 40px;
}

.btn-outline-premium:hover:not([disabled]) {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.3);
}

.btn-primary-premium {
    background: #F5A623;
    color: #020617;
    border: none;
    border-radius: 14px;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.btn-primary-premium:hover:not([disabled]) {
    background: #FFB540;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(245, 166, 35, 0.3);
}

.btn-quick-view {
    background: rgba(255, 255, 255, 0.9);
    color: #020617;
    border: none;
    padding: 8px 16px;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transform: translateY(20px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    align-items: center;
    gap: 6px;
}

.product-img-wrapper:hover .quick-view-overlay {
    opacity: 1;
    pointer-events: auto;
}

.product-img-wrapper:hover .btn-quick-view {
    transform: translateY(0);
}

/* --- Phase 2: Modern Search Experience --- */
.desktop-search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.premium-search-box {
    position: relative;
    display: flex;
    align-items: center;
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 6px 12px;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    width: 200px;
}

.premium-search-box:focus-within {
    width: 320px;
    background: rgba(15, 23, 42, 0.8);
    border-color: rgba(245, 166, 35, 0.5);
    box-shadow: 0 0 15px rgba(245, 166, 35, 0.15);
}

.premium-search-box .search-icon {
    color: #94A3B8;
    margin-right: 8px;
    font-size: 0.9rem;
    transition: color 0.3s ease;
}

.premium-search-box:focus-within .search-icon {
    color: #F5A623;
}

.premium-search-box input {
    background: transparent;
    border: none;
    color: white;
    font-size: 0.9rem;
    width: 100%;
    outline: none;
}

.premium-search-box input::placeholder {
    color: #64748B;
}

/* Search Overlay */
.search-overlay {
    position: fixed;
    top: 70px; /* Below sticky header */
    left: 0;
    width: 100%;
    height: calc(100vh - 70px);
    background: rgba(2, 6, 23, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
    overflow-y: auto;
    padding: 40px 0;
}

.search-overlay.active {
    opacity: 1;
    pointer-events: auto;
}

.search-overlay-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
}

.search-suggestions-container {
    display: flex;
    gap: 30px;
}

.search-block {
    flex: 1;
}

.search-block h3 {
    color: #94A3B8;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.search-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.search-tag {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    color: #CBD5E1;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 6px;
}

.search-tag:hover {
    background: rgba(245, 166, 35, 0.1);
    border-color: rgba(245, 166, 35, 0.3);
    color: #F5A623;
    transform: translateY(-2px);
}

.search-results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
}

/* --- Phase 3: White Studio Image Wrapper --- */
.product-card.premium-card .product-img-wrapper {
    background: #FFFFFF !important; /* Pure white background to hide image backgrounds */
    padding: 15px !important;
    display: flex;
    align-items: center;
    justify-content: center;
}

.product-card.premium-card .product-img-wrapper img.product-img {
    object-fit: contain !important; /* Prevents cropping */
    width: 100%;
    height: 100%;
    mix-blend-mode: normal !important; /* Just in case */
}

/* --- Phase 3: Grid & Whitespace Optimization --- */
.container {
    max-width: 1400px !important; /* Wider container for 5 cards */
}

section.container {
    margin-bottom: 40px !important; /* Tighter spacing between sections */
}

.products-grid {
    display: grid !important;
    gap: 20px !important;
    grid-template-columns: repeat(5, 1fr) !important;
    margin-bottom: 40px !important;
}

@media (max-width: 1200px) {
    .products-grid { grid-template-columns: repeat(4, 1fr) !important; }
}

@media (max-width: 992px) {
    .products-grid { grid-template-columns: repeat(3, 1fr) !important; }
}

@media (max-width: 768px) {
    .products-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 12px !important; }
}

/* --- Phase 4: Dashboard Redesign --- */
.dashboard-header {
    background: var(--bg-card);
    border-radius: 16px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 25px;
    border: 1px solid var(--border-color);
    position: relative;
    overflow: hidden;
}
.dashboard-header::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 4px;
    background: var(--accent-gradient);
}
.dashboard-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--accent-gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 700;
    color: var(--bg-dark);
}
.profile-completion {
    background: rgba(255,255,255,0.05);
    padding: 10px 15px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    margin-left: auto;
    text-align: right;
    min-width: 150px;
}
.progress-bar-bg {
    height: 6px;
    background: rgba(255,255,255,0.1);
    border-radius: 3px;
    margin-top: 5px;
    overflow: hidden;
}
.progress-bar-fill {
    height: 100%;
    background: var(--accent-gradient);
    border-radius: 3px;
}

.quick-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 30px;
}
@media (max-width: 1024px) {
    .quick-stats-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
    .quick-stats-grid { grid-template-columns: 1fr; }
}

.stat-card-premium {
    background: var(--bg-glass);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 20px;
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 15px;
    transition: transform 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
}
.stat-card-premium:hover {
    transform: translateY(-5px);
    border-color: rgba(245,166,35,0.3);
}
.stat-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
}

/* Accordions */
.accordion-item {
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    margin-bottom: 15px;
    overflow: hidden;
}
.accordion-header {
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    transition: background 0.2s;
}
.accordion-header:hover {
    background: rgba(255,255,255,0.05);
}
.accordion-content {
    padding: 0 20px;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
}
.accordion-content.active {
    padding: 20px;
    max-height: 1000px;
    border-top: 1px solid var(--border-color);
}

/* Referral Actions */
.referral-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 15px;
}
.btn-social {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 15px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    color: white;
    transition: opacity 0.2s;
}
.btn-social:hover { opacity: 0.8; }
.btn-copy { background: #334155; }
.btn-whatsapp { background: #25D366; }
.btn-facebook { background: #1877F2; }
.btn-telegram { background: #0088cc; }
.btn-qr { background: var(--accent-gradient); color: var(--bg-dark); }

/* Minimal Dashboard Footer */
.minimal-footer {
    border-top: 1px solid var(--border-color);
    padding: 20px 0;
    margin-top: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    color: var(--text-light);
}
.minimal-footer-links {
    display: flex;
    gap: 20px;
}
.minimal-footer-links a {
    color: var(--text-light);
    text-decoration: none;
    transition: color 0.2s;
}
.minimal-footer-links a:hover {
    color: var(--accent-color);
}
@media (max-width: 768px) {
    .minimal-footer {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }
}

/* Desktop/Mobile Search Bar Visibility Fix */
.mobile-search-toggle {
    display: none !important;
}

@media (max-width: 768px) {
    .mobile-search-toggle {
        display: flex !important;
    }
    .desktop-search-wrapper {
        display: none !important;
    }
}

/* ========================================================= */
/*                   PREMIUM UI OVERRIDES                    */
/* ========================================================= */

:root {
    --primary-color: #0f172a;
    --secondary-color: #040914; 
    --accent-color: #f59e0b;
    --accent-hover: #fbbf24;
    --bg-card: rgba(30, 41, 59, 0.3); 
    --border-color: rgba(255, 255, 255, 0.05);
}

body {
    background-color: var(--secondary-color) !important;
    background-image: 
        radial-gradient(at 10% 20%, rgba(245, 158, 11, 0.06) 0, transparent 40%), 
        radial-gradient(at 80% 0%, rgba(59, 130, 246, 0.06) 0, transparent 50%),
        radial-gradient(at 40% 80%, rgba(236, 72, 153, 0.04) 0, transparent 50%) !important;
}

.product-card.premium-card {
    background: var(--bg-card) !important;
    backdrop-filter: blur(10px) !important;
    -webkit-backdrop-filter: blur(10px) !important;
    border: 1px solid var(--border-color) !important;
    border-radius: 20px !important;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15) !important;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    overflow: hidden !important;
}

.product-card.premium-card:hover {
    transform: translateY(-6px) scale(1.02) !important;
    box-shadow: 0 15px 35px rgba(0,0,0,0.4), 0 0 20px rgba(245, 158, 11, 0.15) !important;
    border-color: rgba(245, 158, 11, 0.4) !important;
}

.product-card.premium-card .product-img-wrapper {
    border-radius: 20px 20px 0 0 !important;
    background: rgba(15, 23, 42, 0.6) !important;
}

.product-card.premium-card .product-title {
    font-size: 1.05rem !important;
    font-weight: 600 !important;
    color: #f8fafc !important;
    margin-bottom: 8px !important;
}

.btn-primary, .btn-outline {
    border-radius: 12px !important;
    font-weight: 600 !important;
    transition: all 0.3s ease !important;
}

.btn-primary:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 20px rgba(245, 158, 11, 0.4) !important;
}

.category-section {
    background: rgba(15, 23, 42, 0.3) !important;
    backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(255,255,255,0.06) !important;
    border-radius: 24px !important;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2) !important;
}

.premium-hero {
    border-radius: 0 0 30px 30px !important;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3) !important;
    border-bottom: 1px solid rgba(255,255,255,0.05) !important;
}
